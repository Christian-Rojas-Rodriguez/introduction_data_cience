library(Metrics)
#============================================
library(metrics)
print(metrics)
#10 ============================================
metrics <- df %>%
group_by(carrier) %>%
summarise(
mediana = median(dep_delay, na.rm = TRUE),
dispersion_iqr = IQR(dep_delay, na.rm = TRUE),
percentil_75 = quantile(dep_delay, 0.75, na.rm = TRUE)
) %>%
arrange(mediana)
print(metrics)
#10 ============================================
metrics <- df %>%
group_by(carrier) %>%
summarise(
mediana = median(dep_delay, na.rm = TRUE),
dispersion_iqr = IQR(dep_delay, na.rm = TRUE),
percentil_90 = quantile(dep_delay, 0.90, na.rm = TRUE)
) %>%
arrange(mediana)
print(metrics)
View(data)
# 11 ============================================
top_2 <- data %>%
group_by(carrier) %>%
filter(n() > 1000) %>%
ungroup() %>%
filter(dest == "LAX") %>%
group_by(carrier) %>%
summarise(max_dep_delay = max(dep_delay, na.rm = TRUE)) %>%
arrange(max_dep_delay) %>%
slice(1:2) %>%
pull(carrier)
df <- data %>%
filter(carrier %in% top_2 & dest == "LAX")
hist <- ggplot(data=df, aes(x=arr_delay, fill=carrier)) +
geom_histogram(position = "identity", alpha = 0.7, bins = 40) +
#coord_cartesian(ylim = c(-30, 800)) +
labs(
title = "Histograma de Retrasos en Llegada (arr_delay) a LAX",
subtitle = "Comparando las 2 aerolíneas con menor retraso máximo en salida",
x = "Retraso en la Llegada (minutos)",
y = "Frecuencia (Cantidad de Vuelos)",
fill = "Aerolínea"
) +
theme_minimal()
ggplot(data=df, aes(x=arr_delay, fill=carrier)) +
geom_histogram(position = "identity", alpha = 0.7, bins = 40) +
